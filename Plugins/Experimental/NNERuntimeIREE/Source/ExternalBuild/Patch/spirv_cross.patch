+	if (UE_requires_half4_packing || UE_requires_float2_unpacking)
+	{
+		// HLSL does not pack into a single word sadly :(
+		statement("uint2 spvPackHalf4(half4 value)");
+		begin_scope();
+		statement("uint4 Packed = f32tof16(value);");
+		statement("return uint2((0x0000ffff & Packed.x) | (Packed.y << 16), (0x0000ffff & Packed.z) | (Packed.w << 16));");
+		end_scope();
+		statement("");
+
+		statement("half4 spvUnpackHalf4(uint2 value)");
