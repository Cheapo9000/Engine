+		statement("return half4(f16tof32(uint4(value.x & 0xffff, value.x >> 16, value.y & 0xffff, value.y >> 16)));");
+		end_scope();
+		statement("");
+
+		statement("half4 spvUnpackFloat2(float2 value)");
+		begin_scope();
+		statement("return spvUnpackHalf4(asuint(value));");
+		end_scope();
+		statement("");
+	}
