 			SPIRV_CROSS_THROW("UShort to Half requires Shader Model 4.");
 		return "(" + type_to_glsl(out_type) + ")f16tof32";
 	}
+	else if (out_type.basetype == SPIRType::UInt && out_type.vecsize == 2 && in_type.basetype == SPIRType::Half && in_type.vecsize == 4)
+	{
+		if (!UE_requires_half4_packing)
+		{
+			UE_requires_half4_packing = true;
+			force_recompile();
+		}
+		return "spvPackHalf4";
+	}
+	else if (out_type.basetype == SPIRType::Half && out_type.vecsize == 4 && in_type.basetype == SPIRType::UInt && in_type.vecsize == 2)
+	{
+		if (!UE_requires_half4_packing)
+		{
+			UE_requires_half4_packing = true;
+			force_recompile();
+		}
+		return "spvUnpackHalf4";
+	}
+	else if (out_type.basetype == SPIRType::Half && out_type.vecsize == 4 && in_type.basetype == SPIRType::Float && in_type.vecsize == 2)
+	{
+		if (!UE_requires_float2_unpacking)
+		{
+			UE_requires_float2_unpacking = true;
+			force_recompile();
+		}
