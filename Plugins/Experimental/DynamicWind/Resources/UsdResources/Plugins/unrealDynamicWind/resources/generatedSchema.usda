class "DynamicWindSkeletonAPI" (
    doc = """This API schema is used by the Unreal Engine's Dynamic Wind plugin to import data that is supplemental to a skeleton,\r
    and required for the plugin to simulate skinned foliage wind animation at run time. Its purpose is to classify joints into\r
    \"simulation groups\" which define how sub-sections of the skeleton behave in the wind, and to provide the data for these\r
    simulation groups to define this behavior.\r
\r
    In Unreal Engine, this data is imported as asset user data on the SkeletalMesh. Note that all simulation group data is\r
    optional, and that the simulation groups assigned to joints will be created with defaults. They can be edited from the\r
    SkeletalMesh properties after import.\r
\r
    # HOW SIMULATION GROUPS WORK\r
\r
    Each simulation group has an associated set of data that defines how these joints are influenced by directional wind, and can\r
    be modified to obtain desirable behavior. Within each simulation group, the system identifies connected bones as chains. Some\r
    of the parameters exposed by this schema have an effect that is applied accordingly to the bone's position in the chain.\r
    For instance, a simulation group could provide a range of influence (min/max), and the influence for each bone in the chain\r
    will be a single value between the two values, based on it's position in the chain, providing variance.\r
\r
    While simulation groups theoretically give the author the power to tweak every branch in the skeleton of their foliage\r
    individually, it is generally recommended to assign them in some way based on their hierarchy. On a tree, for example, one\r
    might assign a simulation group for the trunk, another for large branches, and another for twigs.\r
    """
)
{
    uniform float unreal:dynamicWind:gustAttenuation = 0 (
        doc = "Gust attenuation factor for this object (NOTE: affects trunk simulation groups only)."
    )
    uniform bool unreal:dynamicWind:isGroundCover = 0 (
        doc = "Whether or not to treat this object as ground cover."
    )
    uniform token[] unreal:dynamicWind:jointNames = [] (
        doc = "The list of joint names for joints relevant to dynamic wind."
    )
    uniform int[] unreal:dynamicWind:jointSimulationGroups = [] (
        doc = "The simulation group index of the joints specified by `joints`."
    )
    uniform float[] unreal:dynamicWind:simulationGroupInfluences = [] (
        doc = """The influence values of the simulation groups (Default=1). If `simulationGroupNumInfluences` is left empty,\r
        all joints are assumed to be single-influence, and there will be one entry in this array for each simulation group.\r
        Otherwise, the number of influences should be equal to the sum of all values in `simulationGroupNumInfluences`, which\r
        will determine the offset and number of floats read from this array for each simulation group."""
    )
    uniform int[] unreal:dynamicWind:simulationGroupNumInfluences = [] (
        doc = "The number of influences per simulation group. Valid values are 1 or 2 (Default = 1)."
    )
    uniform float[] unreal:dynamicWind:simulationGroupShiftTops = [] (
        doc = """The ShiftTop value of each simulation group (Default = 0). This is a parameter that is used to attenuate the\r
        influence of wind near the end of each bone chain in a simulation group. See DynamicWindSkeletonAPI schema documentation\r
        for more details."""
    )
    uniform int[] unreal:dynamicWind:trunkSimulationGroups = [] (
        doc = "A list of simulation group indices, specifying which groups are to be considered tree trunks"
    )
}

