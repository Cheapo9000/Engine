  <!-- VBuffer -->
  <Type Name="Verse::VBuffer">
    <Intrinsic Name="_AsCString" SideEffect="false" Expression="(char*)((Header*)Ptr + 1)"/>
    <Intrinsic Name="_Num" SideEffect="false" ReturnType="uint32" Expression="((Header*)Ptr)->NumValues"/>
    <Intrinsic Name="_Capacity" SideEffect="false" ReturnType="uint32" Expression="((Header*)Ptr)->Capacity"/>
    <Intrinsic Name="_Type" SideEffect="false" ReturnType="EArrayType" Expression="EArrayType(((Header*)Ptr)->Type)"/>
    
    <DisplayString Condition="(Header*)Ptr == nullptr">None[0]</DisplayString>
    <DisplayString Condition="_Type() == EArrayType::VValue">VValue[{_Num(),d}/{_Capacity(),d}]</DisplayString>
    <DisplayString Condition="_Type() == EArrayType::Int32">Int32[{_Num(),d}/{_Capacity(),d}]</DisplayString>
    <DisplayString Condition="_Type() == EArrayType::Char8">Char8[{_Num(),d}/{_Capacity(),d}] {(char*)((Header*)Ptr + 1),s8}</DisplayString>
    <DisplayString Condition="_Type() == EArrayType::Char32">Char32[{_Num(),d}/{_Capacity(),d}]</DisplayString>
    <Expand>
      <Item Name="Capacity">_Capacity()</Item>
      <ArrayItems Condition="_Type() != EArrayType::None">
        <Size>_Num()</Size>
        <ValuePointer Condition="_Type() == EArrayType::VValue">(VValue*)((Header*)Ptr + 1)</ValuePointer>
        <ValuePointer Condition="_Type() == EArrayType::Int32">(int32*)((Header*)Ptr + 1)</ValuePointer>
        <ValuePointer Condition="_Type() == EArrayType::Char8">(uint8*)((Header*)Ptr + 1)</ValuePointer>
        <ValuePointer Condition="_Type() == EArrayType::Char32">(uint32*)((Header*)Ptr + 1)</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- VCell (keep subtypes in alphabetical order, and make sure each has a visualizer below, even if empty) -->
  <Type Name="Verse::VCell">
    <Intrinsic Name="_GetEmergentType" SideEffect="false" ReturnType="Verse::VEmergentType*" Expression="(Verse::VEmergentType*)((char*)Verse::FHeap::EmergentTypeBase + this->EmergentTypeOffset * Verse::FHeap::EmergentAlignment)" />

    <DisplayString Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VArray::StaticCppClassInfo">Array ({*(Verse::VArray*)this})</DisplayString>
    <DisplayString Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VUniqueString::StaticCppClassInfo">UniqueString ({*(Verse::VUniqueString*)this})</DisplayString>
    <DisplayString Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VValueObject::StaticCppClassInfo">VValueObject: {((VNamedType*)_GetEmergentType()->Type.Value)->BaseName.Value->_AsCString(),s8b}</DisplayString>
    <DisplayString>Cell ({_GetEmergentType()->CppClassInfo->Name,sub})</DisplayString>
    <Expand>
      <Item Name="EmergentType">*_GetEmergentType()</Item>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VArchetype::StaticCppClassInfo">(Verse::VArchetype*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VArray::StaticCppClassInfo">(Verse::VArray*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VArrayType::StaticCppClassInfo">(Verse::VArrayType*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VBytecodeSuspension::StaticCppClassInfo">(Verse::VBytecodeSuspension*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VClass::StaticCppClassInfo">(Verse::VClass*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VEmergentType::StaticCppClassInfo">(Verse::VEmergentType*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VFrame::StaticCppClassInfo">(Verse::VFrame*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VFunction::StaticCppClassInfo">(Verse::VFunction*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VHeapInt::StaticCppClassInfo">(Verse::VHeapInt*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VMap::StaticCppClassInfo">(Verse::VMap*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VMutableArray::StaticCppClassInfo">(Verse::VMutableArray*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VMutableMap::StaticCppClassInfo">(Verse::VMutableMap*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VNativeFunction::StaticCppClassInfo">(Verse::VNativeFunction*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VNativeConstructorWrapper::StaticCppClassInfo">(Verse::VNativeConstructorWrapper*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VNativeRef::StaticCppClassInfo">(Verse::VNativeRef*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VOption::StaticCppClassInfo">(Verse::VOption*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VPackage::StaticCppClassInfo">(Verse::VPackage*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VPointerType::StaticCppClassInfo">(Verse::VPointerType*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VProcedure::StaticCppClassInfo">(Verse::VProcedure*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VProgram::StaticCppClassInfo">(Verse::VProgram*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VRational::StaticCppClassInfo">(Verse::VRational*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VScope::StaticCppClassInfo">(Verse::VScope*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VShape::StaticCppClassInfo">(Verse::VShape*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VSuspension::StaticCppClassInfo">(Verse::VSuspension*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VUniqueString::StaticCppClassInfo">(Verse::VUniqueString*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VValueObject::StaticCppClassInfo">(Verse::VValueObject*)this</ExpandedItem>
      <ExpandedItem Condition="_GetEmergentType()->CppClassInfo == &amp;Verse::VRef::StaticCppClassInfo">(Verse::VRef*)this</ExpandedItem>
    </Expand>
  </Type>

  <!-- VArrayBase -->
  <Type Name="Verse::VArrayBase">
    <Intrinsic Name="_AsCString" SideEffect="false" Expression="Buffer.Value._AsCString()"/>
    
    <DisplayString>{Buffer.Value}</DisplayString>
    <Expand>
      <ExpandedItem>Buffer.Value</ExpandedItem>
    </Expand>
  </Type>

  <!-- VArrayType -->
  <Type Name="Verse::VArrayType">
  </Type>

  <!-- VClass -->
  <Type Name="Verse::VClass">
  </Type>

  <!-- VArchetype -->
  <Type Name="Verse::VArchetype">
    <DisplayString>[{NumEntries,d}]</DisplayString>
    <Expand>
      <Item Name="Class">Class</Item>
      <Item Name="NextArchetype">NextArchetype</Item>
      <ArrayItems>
        <Size>NumEntries</Size>
        <ValuePointer>Entries</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- VEmergentType -->
  <Type Name="Verse::VEmergentType">
  </Type>

  <!-- VFrame -->
  <Type Name="Verse::VFrame">
    <Expand>
      <ArrayItems>
        <Size>NumRegisters</Size>
        <ValuePointer>Registers</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- VFunction -->
  <Type Name="Verse::VFunction">
  </Type>

  <!-- VHeapInt -->
  <Type Name="Verse::VHeapInt">
    <DisplayString>[{Length,d}]</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>Length</Size>
        <ValuePointer>Digits</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- VMapBase -->
  <Type Name="Verse::VMapBase">
  </Type>

  <!-- VNamedType -->
  <Type Name="Verse::VNamedType">
  </Type>

  <!-- VNativeFunction -->
  <Type Name="Verse::VNativeFunction">
  </Type>

  <!-- VNativeRef -->
  <Type Name="Verse::VNativeRef">
  </Type>

  <!-- VOption -->
  <Type Name="Verse::VOption">
    <DisplayString>Option ({Value}))</DisplayString>
  </Type>

  <!-- VPackage -->
  <Type Name="Verse::VPackage">
    <DisplayString>[{*Name.Value} - {((VBuffer::Header*)Definitions.NameAndValues.Value->Buffer.Value.Ptr)->NumValues / 2,d}]</DisplayString>
  </Type>

  <!-- VPointerType -->
  <Type Name="Verse::VPointerType">
  </Type>

  <!-- VProcedure -->
  <Type Name="Verse::VProcedure">
    <Intrinsic Name="_GetNamedParams" SideEffect="false" Expression="(Verse::FNamedParam*)Trailing"/>
    <Intrinsic Name="_GetConstants" SideEffect="false" Expression="(Verse::TWriteBarrier&lt;Verse::VValue&gt;*)(_GetNamedParams() + NumNamedParameters)"/>
    <Intrinsic Name="_GetOpBytes" SideEffect="false" Expression="(uint8*)(_GetConstants() + NumConstants)"/>
    <Intrinsic Name="_GetOperands" SideEffect="false" Expression="(Verse::FValueOperand*)(_GetOpBytes() + NumOpBytes)"/>
    <Intrinsic Name="_GetLabels" SideEffect="false" Expression="(Verse::FLabelOffset*)(_GetOperands() + NumOperands)"/>
    <Intrinsic Name="_GetUnwindEdges" SideEffect="false" Expression="(Verse::FUnwindEdge*)(_GetLabels() + NumLabels)"/>
    <Intrinsic Name="_GetOpLocations" SideEffect="false" Expression="(Verse::FOpLocation*)(_GetUnwindEdges() + NumUnwindEdges)"/>
    <Intrinsic Name="_GetRegisterNames" SideEffect="false" Expression="(Verse::FRegisterName*)_AlignInt((uintptr_t)(_GetOpLocations() + NumOpLocations), 8)"/>

    <Expand>
      <Item Name="FilePath">FilePath</Item>
      <Item Name="Name">Name</Item>
      <Synthetic Name="NamedParameters">
        <DisplayString>[{NumNamedParameters}]</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>NumNamedParameters</Size>
            <ValuePointer>_GetNamedParams()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="Constants">
        <DisplayString>[{NumConstants}]</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>NumConstants</Size>
            <ValuePointer>_GetConstants()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="OpBytes">
        <DisplayString>[{NumOpBytes}]</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>NumOpBytes</Size>
            <ValuePointer>_GetOpBytes()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="Operands">
        <DisplayString>[{NumOperands}]</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>NumOperands</Size>
            <ValuePointer>_GetOperands()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="Labels">
        <DisplayString>[{NumLabels}]</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>NumLabels</Size>
            <ValuePointer>_GetLabels()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="UnwindEdges">
        <DisplayString>[{NumUnwindEdges}]</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>NumUnwindEdges</Size>
            <ValuePointer>_GetUnwindEdges()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="OpLocations">
        <DisplayString>[{NumOpLocations}]</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>NumOpLocations</Size>
            <ValuePointer>_GetOpLocations()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="RegisterNames">
        <DisplayString>[{NumRegisterNames}]</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>NumRegisterNames</Size>
            <ValuePointer>_GetRegisterNames()</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <Type Name="Verse::FValueOperand">
    <DisplayString Condition="Index &lt; UNINITIALIZED">{Register}</DisplayString>
    <DisplayString Condition="UNINITIALIZED &lt;= Index">{Constant}</DisplayString>
  </Type>
  <Type Name="Verse::FNamedParam">
    <DisplayString>{Name}: {Index}</DisplayString>
  </Type>
  <Type Name="Verse::FRegisterIndex">
    <DisplayString>r{Index}</DisplayString>
  </Type>

  <!-- VProgram -->
  <Type Name="Verse::VProgram">
    <DisplayString>[{((VBuffer::Header*)PackageMap.NameAndValues.Value->Buffer.Value.Ptr)->NumValues / 2,d}]</DisplayString>
  </Type>

  <!-- VRational -->
  <Type Name="Verse::VRational">
    <DisplayString>{Numerator.Value}/{Denominator.Value}</DisplayString>
    <Expand>
      <Item Name="Numerator">Numerator.Value</Item>
      <Item Name="Denominator">Denominator.Value</Item>
    </Expand>
  </Type>

  <!-- VScope -->
  <Type Name="Verse::VScope">
  </Type>

  <!-- VShape -->
  <Type Name="Verse::VShape">
  </Type>

  <!-- VValueObject -->
  <Type Name="Verse::VValueObject">
    <Intrinsic Name="_GetFieldPairs" SideEffect="false" Expression="&amp;_GetEmergentType()->Shape.Value->Fields.Pairs"/>
    <Intrinsic Name="_GetData" SideEffect="false" ReturnType="VRestValue*" Expression="(VRestValue*)((uint8*)this + _AlignInt(_GetEmergentType()->CppClassInfo->SizeWithoutFields, DataAlignment))"/>
    <Intrinsic Name="_GetFieldValue" SideEffect="false" ReturnType="VValue*" Expression="Field.Type == EFieldType::Offset ? &amp;_GetData()[Field.Index].Value.Value : Field.Type == EFieldType::Constant ? &amp;Field.Value.Value : nullptr">
      <Parameter Name="Field" Type="VShape::VEntry&amp;"/>
    </Intrinsic>

    <DisplayString>VValueObject: {((VNamedType*)_GetEmergentType()->Type.Value)->BaseName.Value->_AsCString(),s8b}</DisplayString>
    <Expand>
      <CustomListItems>
        <Variable Name="Index" InitialValue="0" />
        <Variable Name="ElementsAdded" InitialValue="0" />
        <Variable Name="ElementsCount" InitialValue="_GetFieldPairs()->_Num()" />
        <Size>_GetFieldPairs()->_Num()</Size>
        <Loop Condition="ElementsAdded &lt; ElementsCount">
          <If Condition="_GetFieldPairs()->Elements._IsValidIndex(Index)">
            <Item Name="(Field) {_GetFieldPairs()->Elements._GetElementPtr(Index)->Value.Key.Value->_AsCString(),s8b}">*_GetFieldValue(_GetFieldPairs()->Elements._GetElementPtr(Index)->Value.Value)</Item>
            <Exec>++ElementsAdded</Exec>
          </If>
          <Exec>++Index</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <!-- VRef -->
  <Type Name="Verse::VRef">
  </Type>

  <!-- VSuspension -->
  <Type Name="Verse::VSuspension">
  </Type>
  
  <!-- VBytecodeSuspension -->
  <Type Name="Verse::VBytecodeSuspension">
    <DisplayString>Procedure| {Procedure.Get()->Name.Get()}</DisplayString>
  </Type>  

  <!-- Verse::CSymbolEntry -->
  <Type Name="Verse::CSymbolEntry">
    <DisplayString>Definition = {(uLang::CDefinition*)((uintptr_t)Definition &amp; (uintptr_t)~0x7)}, Type = {(Verse::ESymbolEntryType)((uintptr_t)Definition &amp; (uintptr_t)0x7)}</DisplayString>
    <Expand>
      <Item Name="Definition">(uLang::CDefinition*)((uintptr_t)Definition &amp; (uintptr_t)~0x7)</Item>
      <Item Name="Type">(Verse::ESymbolEntryType)((uintptr_t)Definition &amp; (uintptr_t)0x7)</Item>
    </Expand>
  </Type>

  <!-- Verse::VNativeConstructorWrapper -->
  <Type Name="Verse::VNativeConstructorWrapper">
  </Type>

</AutoVisualizer>
