      <Item Name="[Value]">($T1*)InstancedStruct.StructMemory</Item>
    </Expand>
  </Type>

  <!-- TDirectoryTree::FTreeNode visualizer -->
  <Type Name="TDirectoryTree&lt;*&gt;::FTreeNode">
    <Expand>
      <Synthetic Name="Value" Condition="(NumChildNodesAndFlags &amp; FlagsMask) == 0">
        <DisplayString>Empty</DisplayString>
      </Synthetic>
      <Item Name="Value" Condition="(NumChildNodesAndFlags &amp; FlagsMask) != 0">Value</Item>
      <Synthetic Name="RelPaths">
        <DisplayString>Num={(int32)(NumChildNodesAndFlags &amp; ~FlagsMask)}</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>(int32)(NumChildNodesAndFlags &amp; ~FlagsMask)</Size>
            <ValuePointer>RelPaths.Ptr</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Synthetic Name="ChildNodes">
        <DisplayString>Num={(int32)(NumChildNodesAndFlags &amp; ~FlagsMask)}</DisplayString>
        <Expand>
          <ArrayItems>
            <Size>(int32)(NumChildNodesAndFlags &amp; ~FlagsMask)</Size>
            <ValuePointer>ChildNodes.Ptr</ValuePointer>
          </ArrayItems>
        </Expand>
      </Synthetic>
      <Item Name="NumChildNodesAndFlags">NumChildNodesAndFlags</Item>
      <Item Name="CapacityChildNodes">CapacityChildNodes</Item>
    </Expand>
  </Type>

  <!-- FInstancedPropertyBag visualizer -->
  <Type Name="FInstancedPropertyBag">
    <DisplayString Condition="Value.ScriptStruct == nullptr">Empty</DisplayString>
    <Expand>
      <Synthetic Name="[InstancedPropertyBag]">
        <DisplayString Condition="Value.ScriptStruct == nullptr">Empty</DisplayString>
        <DisplayString>
          PropertiesNum={(*((UPropertyBag*)(*(UScriptStruct**)&amp;Value.ScriptStruct.ObjectPtr.Handle))).PropertyDescs.ArrayNum}, PropertiesSize={(*((UStruct*)(*(UScriptStruct**)&amp;Value.ScriptStruct.ObjectPtr.Handle))).PropertiesSize}
        </DisplayString>
        <Expand>
          <CustomListItems>
            <Variable Name="Index" InitialValue="0"/>
            <Variable Name="ArrayNum" InitialValue="(*((UPropertyBag*)(*(UScriptStruct**)&amp;Value.ScriptStruct.ObjectPtr.Handle))).PropertyDescs.ArrayNum"/>
            <!-- Per property variables -->
            <Variable Name="Name" InitialValue="(const FName*)nullptr"/>
            <Variable Name="ValueType" InitialValue="EPropertyBagPropertyType::None"/>
            <Variable Name="ValueTypeObject" InitialValue="(const UObject*)nullptr"/>
            <Variable Name="ValueTypeObjectName" InitialValue="(const FName*)nullptr"/>
            <Variable Name="PropertyPtr" InitialValue="(const void*)nullptr"/>
            <Variable Name="bShowStructPtr" InitialValue="true"/>
            <Loop Condition="Index &lt; ArrayNum">
              <Exec>Name = &amp;(*((UPropertyBag*)(*(UScriptStruct**)&amp;Value.ScriptStruct.ObjectPtr.Handle))).PropertyDescs[Index].Name</Exec>
              <Exec>ValueTypeObject = (*((UPropertyBag*)(*(UScriptStruct**)&amp;Value.ScriptStruct.ObjectPtr.Handle))).PropertyDescs[Index].ValueTypeObject.ObjectPtr.DebugPtr</Exec>
              <Exec>PropertyPtr = Value.StructMemory + (*((UPropertyBag*)(*(UScriptStruct**)&amp;Value.ScriptStruct.ObjectPtr.Handle))).PropertyDescs[Index].CachedProperty->Offset_Internal</Exec>
              <Exec>ValueType = (*((UPropertyBag*)(*(UScriptStruct**)&amp;Value.ScriptStruct.ObjectPtr.Handle))).PropertyDescs[Index].ValueType</Exec>
              <Exec>bShowStructPtr = true</Exec>
              <If Condition="ValueTypeObject != nullptr">
                <Exec>ValueTypeObjectName = &amp;(*((UObjectBase*)(*(UObject**)&amp;(*((UPropertyBag*)(*(UScriptStruct**)&amp;Value.ScriptStruct.ObjectPtr.Handle))).PropertyDescs[Index].ValueTypeObject.ObjectPtr.Handle))).NamePrivate,sb</Exec>
              </If>
              <!-- Determine if we want to show struct ptr at start of loop, running an exec after an item will prevent rest of loop and item from processing. -->
              <If Condition="ValueType == EPropertyBagPropertyType::Struct &amp;&amp; ValueTypeObjectName">
                <Exec Condition="memcmp(&amp;(*ValueTypeObjectName)[0], &quot;Vector&quot;, 6) == 0">bShowStructPtr = false</Exec>
                <Exec Condition="memcmp(&amp;(*ValueTypeObjectName)[0], &quot;Rotator&quot;, 7) == 0">bShowStructPtr = false</Exec>
                <Exec Condition="memcmp(&amp;(*ValueTypeObjectName)[0], &quot;Quat&quot;, 4) == 0">bShowStructPtr = false</Exec>
                <Exec Condition="memcmp(&amp;(*ValueTypeObjectName)[0], &quot;Transform&quot;, 9) == 0">bShowStructPtr = false</Exec>
                <Exec Condition="memcmp(&amp;(*ValueTypeObjectName)[0], &quot;Matrix&quot;, 6) == 0">bShowStructPtr = false</Exec>
              </If>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::Bool">(bool*)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::Byte">(uint8*)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::Int32">(int32*)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::Int64">(int64*)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::Float">(float*)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::Double">(double*)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::Name">(FName*)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::String">(FString*)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::Text">(FText*)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::Enum">(uint8*)PropertyPtr</Item>
                <If Condition="ValueType == EPropertyBagPropertyType::Struct &amp;&amp; ValueTypeObjectName">
                  <Item Name="[{Index} {*Name,sb}]" Condition="memcmp(&amp;(*ValueTypeObjectName)[0], &quot;Vector&quot;, 6) == 0">(FVector*)PropertyPtr</Item>
                  <Item Name="[{Index} {*Name,sb}]" Condition="memcmp(&amp;(*ValueTypeObjectName)[0], &quot;Rotator&quot;, 7) == 0">(FRotator*)PropertyPtr</Item>
                  <Item Name="[{Index} {*Name,sb}]" Condition="memcmp(&amp;(*ValueTypeObjectName)[0], &quot;Quat&quot;, 4) == 0">(FQuat*)PropertyPtr</Item>
                  <Item Name="[{Index} {*Name,sb}]" Condition="memcmp(&amp;(*ValueTypeObjectName)[0], &quot;Transform&quot;, 9) == 0">(FTransform*)PropertyPtr</Item>
                  <Item Name="[{Index} {*Name,sb}]" Condition="memcmp(&amp;(*ValueTypeObjectName)[0], &quot;Matrix&quot;, 6) == 0">(FMatrix*)PropertyPtr</Item>
                </If>
                <Item Name="[{Index} {*Name,sb}] (F{*ValueTypeObjectName,sb}*)" Condition="ValueType == EPropertyBagPropertyType::Struct &amp;&amp; bShowStructPtr">PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}] (U{*ValueTypeObjectName,sb}*)" Condition="ValueType == EPropertyBagPropertyType::Object">(UObject**)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}] (U{*ValueTypeObjectName,sb}*)" Condition="ValueType == EPropertyBagPropertyType::SoftObject">PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}] (U{*ValueTypeObjectName,sb}*)" Condition="ValueType == EPropertyBagPropertyType::Class">(UClass**)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}] (U{*ValueTypeObjectName,sb}*)" Condition="ValueType == EPropertyBagPropertyType::SoftClass">PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::UInt32">(uint32*)PropertyPtr</Item>
                <Item Name="[{Index} {*Name,sb}]" Condition="ValueType == EPropertyBagPropertyType::UInt64">(uint64*)PropertyPtr</Item>
              <Exec>++Index</Exec>
            </Loop>
          </CustomListItems>
          <Item Name="[PropertiesNum]">(*((UPropertyBag*)(*(UScriptStruct**)&amp;Value.ScriptStruct.ObjectPtr.Handle))).PropertyDescs.ArrayNum</Item>
          <Item Name="[PropertiesSize]">(*((UStruct*)(*(UScriptStruct**)&amp;Value.ScriptStruct.ObjectPtr.Handle))).PropertiesSize</Item>
          <Item Name="[Raw View]">Value,view(simple)</Item>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>


  <!-- Epic Games, Inc. Verse VM Visualizers -->

  <!-- VValue -->
  <Type Name="Verse::VValue">
    <DisplayString Condition="EncodedBits == UninitializedValue">Uninitialized</DisplayString>
    <DisplayString Condition="(EncodedBits &amp; NumberTagMask) == Int32Tag">int32({Bits.Payload})</DisplayString>
    <DisplayString Condition="(EncodedBits &amp; NumberTagMask) &amp;&amp; (EncodedBits &amp; NumberTagMask) != Int32Tag">double({EncodedBits - FloatOffset,X})</DisplayString>
    <DisplayString Condition="!(EncodedBits &amp; NonCellTagMask) &amp;&amp; EncodedBits != UninitializedValue">{Cell}</DisplayString>
    <DisplayString Condition="(EncodedBits &amp; NonCellTagMask) == PlaceholderTag">Placeholder</DisplayString>
    <DisplayString Condition="(EncodedBits &amp; NonCellTagMask) == TransparentRefTag">Transparent Ref</DisplayString>
    <DisplayString Condition="(EncodedBits &amp; NonCellTagMask) == RootTag">Root(SplitDepth = {(EncodedBits >> 32) &amp; 0xffff})</DisplayString>
    <DisplayString Condition="(EncodedBits &amp; UObjectTagMask) == UObjectTag">UObject (Name={((UObjectBase*)(EncodedBits &amp; ~UObjectTag))->NamePrivate})</DisplayString>
    <DisplayString Condition="(EncodedBits &amp; NonCellTagMask) == CharTag">char8({char(EncodedBits >> NumLowerEncodingBits),c})</DisplayString>
    <DisplayString Condition="(EncodedBits &amp; NonCellTagMask) == Char32Tag">char32({EncodedBits >> NumLowerEncodingBits})</DisplayString>
    <DisplayString>???</DisplayString>
    <Expand>
      <ExpandedItem Condition="(EncodedBits &amp; NonCellTagMask) == PlaceholderTag">(Verse::VPlaceholder*)((uintptr_t)Cell &amp; ~NonCellTagMask)</ExpandedItem>
      <ExpandedItem Condition="(EncodedBits &amp; NonCellTagMask) == TransparentRefTag">(Verse::VRef*)((uintptr_t)Cell &amp; ~NonCellTagMask)</ExpandedItem>
      <ExpandedItem Condition="(EncodedBits &amp; UObjectTagMask) == UObjectTag">((UObject*)(EncodedBits &amp; ~UObjectTag))</ExpandedItem>
      <ExpandedItem Condition="!(EncodedBits &amp; NonCellTagMask) &amp;&amp; Cell != 0">Cell</ExpandedItem>
    </Expand>
  </Type>

