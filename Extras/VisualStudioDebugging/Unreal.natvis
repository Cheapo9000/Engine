    <DisplayString Condition="this->_Max() > 0">Empty, Max={(*this)._Max()}</DisplayString>
    <DisplayString>Empty</DisplayString>
    <Expand>
      <IndexListItems>
        <Size>this-&gt;_IsValid() ? Data._Num() : 0</Size>
        <ValueNode Condition="this->_IsValidIndex($i)">*(*this)._GetElementPtr($i)</ValueNode>
        <ValueNode Condition="!this->_IsValidIndex($i)">"Invalid",sb</ValueNode>
      </IndexListItems>
    </Expand>
