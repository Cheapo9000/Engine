    <DisplayString>Tri: {ContactTriangleIndex} Verts: {EdgeOrVertexID} NormalDot: {ContactNormalDotTriangleNormal}</DisplayString>
  </Type>

  <Type Name="Chaos::Private::FMeshContactGeneratorTriangle">
