    <DisplayString Condition="UnfrozenPtr != 0 &amp;&amp; (Packed &amp; 1) != 0">{*($T1*)((char*)this + (int64(Packed) >> 24))}</DisplayString>
    <DisplayString Condition="UnfrozenPtr != 0 &amp;&amp; (Packed &amp; 1) == 0">{*($T1*)UnfrozenPtr}</DisplayString>
