  <!-- TOptional visualizer -->
  <Type Name="TOptional&lt;*&gt;">
    <SmartPointer Usage="Minimal">($T1*)&amp;TypedValue</SmartPointer>
    <!-- Until we can generically detect whether a value with an intrusive unset state is set or unset, we just always display
         the value with an "Optional:" prefix, letting the type's own visualizer control how it shows its 'unset' state. -->
    <DisplayString Condition="sizeof(*this) == sizeof($T1)">Optional: {{{TypedValue}}}</DisplayString>
    <DisplayString Condition="sizeof(*this) != sizeof($T1) &amp;&amp; !bIsSet" Optional="true">Unset</DisplayString>
    <DisplayString Condition="sizeof(*this) != sizeof($T1) &amp;&amp; bIsSet" Optional="true">Set: {{{TypedValue}}}</DisplayString>
    <Expand>
      <ExpandedItem Condition="sizeof(*this) != sizeof($T1) &amp;&amp; bIsSet" Optional="true">TypedValue</ExpandedItem>
      <ExpandedItem Condition="sizeof(*this) == sizeof($T1)">TypedValue</ExpandedItem>
    </Expand>
  </Type>

