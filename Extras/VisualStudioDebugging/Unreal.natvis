  <Type Name="FHashedNameDebugString">
    <DisplayString Condition="String.UnfrozenPtr == 0">Empty</DisplayString>
    <DisplayString Condition="(String.Frozen.Packed &amp; 1) != 0">{(char*)this + (int64(String.Frozen.Packed) >> 24)}</DisplayString>
    <DisplayString>{String.UnfrozenPtr}</DisplayString>
  </Type>

  <!-- TMapBase visualizer -->
  <Type Name="TMapBase&lt;*,*,*,*&gt;">
    <AlternativeType Name="TCompactMapBase&lt;*,*,*,*&gt;"/>
    <AlternativeType Name="TSparseMapBase&lt;*,*,*,*&gt;"/>
    <Intrinsic Name="_Num" Expression="Pairs._Num()" />
    <Intrinsic Name="_Max" Expression="Pairs._Max()" />
    <Intrinsic Name="_IsValid" Expression="Pairs._IsValid()" />
    <Intrinsic Name="_GetData" Expression="Pairs._GetData()"/>
    <Intrinsic Name="_GetAllocationFlag" Expression="Pairs._GetAllocationFlag(Index)">
      <Parameter Name="Index" Type="int64"/>
    </Intrinsic>
    <!-- Workaround: The cast to TTuple should be redundant, but is needed for some platforms. -->
    <Intrinsic Name="_GetElementPtr" Expression="(TTuple&lt;$T1,$T2&gt;*)Pairs._GetElementPtr(Index)">
      <Parameter Name="Index" Type="int64"/>
    </Intrinsic>
    <DisplayString Condition="!this->_IsValid()">Invalid</DisplayString>
    <DisplayString Condition="this->_Num() > 0">Num={(*this)._Num()}, Max={(*this)._Max()}</DisplayString>
    <DisplayString Condition="this->_Max() > 0">Empty, Max={(*this)._Max()}</DisplayString>
    <DisplayString>Empty</DisplayString>
    <Expand>
      <CustomListItems>
        <Variable Name="Index" InitialValue="0" />
        <!-- Workaround: ElementsAdded and ElementsCount exist so that we could explicitly track the number of items added and break
                         the loop. It's needed because on some platforms CustomListItems does not properly handle the Size tag and we
                         ended up with unbounded iteration over the collection leading to freezes in Visual Studio.
                         Intended to be removed once the debugger incompatibility on the platform in question is resolved.
                         Other visualizers using CustomListItems have been also updated. -->
        <Variable Name="ElementsAdded" InitialValue="0" />
        <Variable Name="ElementsCount" InitialValue="this->_Num()" />
        <Size>(*this)._IsValid() ? (*this)._Num() : 0</Size>
        <Loop Condition="ElementsCount > ElementsAdded">
          <If Condition="this->_GetAllocationFlag(Index)">
            <Item Name="[{this->_GetElementPtr(Index)->Key}]">(*this)._GetElementPtr(Index)->Value</Item>
            <Exec>++ElementsAdded</Exec>
          </If>
          <Exec>++Index</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <!-- TSortedMap visualizer -->
  <Type Name="TSortedMap&lt;*,*,*&gt;">
    <Intrinsic Name="_Num" Expression="Pairs._Num()" />
    <Intrinsic Name="_Max" Expression="Pairs._Max()" />
    <Intrinsic Name="_IsValid" Expression="Pairs._IsValid()" />
    <Intrinsic Name="_GetData" Expression="Pairs._GetData()"/>
    <!-- Workaround: The cast to TTuple should be redundant, but is needed for some platforms. -->
    <Intrinsic Name="_GetElementPtr" Expression="(TTuple&lt;$T1,$T2&gt;*)(this->_GetData() + Index)">
      <Parameter Name="Index" Type="int64"/>
    </Intrinsic>
    <DisplayString Condition="!this->_IsValid()">Invalid</DisplayString>
    <DisplayString Condition="this->_Num() > 0">Num={(*this)._Num()}, Max={(*this)._Max()}</DisplayString>
    <DisplayString Condition="this->_Max() > 0">Empty, Max={(*this)._Max()}</DisplayString>
    <DisplayString>Empty</DisplayString>
    <Expand>
      <CustomListItems>
        <Variable Name="Index" InitialValue="0" />
        <!-- Workaround: ElementsAdded and ElementsCount exist so that we could explicitly track the number of items added and break
                         the loop. It's needed because on some platforms CustomListItems does not properly handle the Size tag and we
                         ended up with unbounded iteration over the collection leading to freezes in Visual Studio.
                         Intended to be removed once the debugger incompatibility on the platform in question is resolved.
                         Other visualizers using CustomListItems have been also updated. -->
        <Variable Name="ElementsCount" InitialValue="this->_Num()" />
        <Size>(*this)._IsValid() ? (*this)._Num() : 0</Size>
        <Loop Condition="ElementsCount > Index">
          <Item Name="[{this->_GetElementPtr(Index)->Key}]">(*this)._GetElementPtr(Index)->Value</Item>
          <Exec>++Index</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <!-- TSet is here twice because it can either be backed by TCompactSet or TSparseSet but not by a using alias at the moment so it needs a full definition
       As long as one of them works properly it will show correctly, these can be removed if we switch back to a using alias -->

  <Type Name="TSparseSet&lt;*,*,*&gt;" Priority="High">
    <AlternativeType Name="TSet&lt;*,*,*&gt;"/>
    <Intrinsic Name="_Num" Expression="Elements.Data.ArrayNum - Elements.NumFreeIndices" />
    <Intrinsic Name="_Max" Expression="Elements.Data.ArrayMax" />
    <Intrinsic Name="_IsValid" Expression="Elements._IsValid() &amp;&amp; this->_Num() >= 0 &amp;&amp; this->_Max() >= this->_Num()  &amp;&amp; Elements.NumFreeIndices >= 0 &amp;&amp; this->_Max() >= Elements.NumFreeIndices" />
    <Intrinsic Name="_GetData" Expression="(TSparseSetElement&lt;$T1&gt;*)Elements._GetData()"/>
    <Intrinsic Name="_GetAllocationFlag" Expression="Elements._IsValidIndex(Index)">
      <Parameter Name="Index" Type="int64"/>
    </Intrinsic>
    <Intrinsic Name="_GetElementPtr" Expression="&amp;(this->_GetData() + Index)->Value">
      <Parameter Name="Index" Type="int64"/>
    </Intrinsic>
    <DisplayString Condition="!this->_IsValid()">Invalid</DisplayString>
    <DisplayString Condition="this->_Num() > 0">Num={(*this)._Num()}, Max={(*this)._Max()}</DisplayString>
    <DisplayString Condition="this->_Max() > 0">Empty, Max={(*this)._Max()}</DisplayString>
    <DisplayString>Empty</DisplayString>
    <Expand>
      <CustomListItems>
        <Variable Name="Index" InitialValue="0" />
        <!-- Workaround: ElementsAdded and ElementsCount exist so that we could explicitly track the number of items added and break
                         the loop. It's needed because on some platforms CustomListItems does not properly handle the Size tag and we
                         ended up with unbounded iteration over the collection leading to freezes in Visual Studio.
                         Intended to be removed once the debugger incompatibility on the platform in question is resolved.
                         Other visualizers using CustomListItems have been also updated. -->
        <Variable Name="ElementsAdded" InitialValue="0" />
        <Variable Name="ElementsCount" InitialValue="this->_Num()" />
        <Size>(*this)._IsValid() ? (*this)._Num() : 0</Size>
        <Loop Condition="ElementsCount > ElementsAdded">
          <If Condition="this->_GetAllocationFlag(Index)">
            <Item>*(*this)._GetElementPtr(Index)</Item>
            <Exec>++ElementsAdded</Exec>
          </If>
          <Exec>++Index</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <Type Name="TCompactSet&lt;*,*,*&gt;" >
    <AlternativeType Name="TSet&lt;*,*,*&gt;"/>
    <Intrinsic Name="_Num" Expression="NumElements" />
    <Intrinsic Name="_Max" Expression="MaxElements" />
    <Intrinsic Name="_IsValid" Expression="NumElements >= 0 &amp;&amp; MaxElements >= MaxElements" />
    <Intrinsic Name="_GetData" Expression="($T1*)Elements._GetData()"/>
    <Intrinsic Name="_GetAllocationFlag" Expression="true">
      <Parameter Name="Index" Type="int64"/>
    </Intrinsic>
    <Intrinsic Name="_GetElementPtr" Expression="this->_GetData() + Index">
      <Parameter Name="Index" Type="int64"/>
    </Intrinsic>

    <DisplayString Condition="MaxElements == 0">Empty</DisplayString>
    <DisplayString Condition="NumElements == 0 &amp;&amp; MaxElements != 0">Empty, Max={MaxElements}</DisplayString>
    <DisplayString Condition="NumElements &lt;= MaxElements">Num={NumElements}, Max={MaxElements}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>NumElements</Size>
        <ValuePointer>this->_GetData()</ValuePointer>
      </ArrayItems>
      <Synthetic Name="Internals">
        <Expand>
          <Item Condition="MaxElements != 0" Name="HashCount">*(uint32*)(this->_GetData() + MaxElements)</Item>
          <Item Condition="MaxElements &gt; 0 &amp;&amp; MaxElements &lt; 256" Name="Next Indices" ExcludeView="simple">(uint8*)(this->_GetData() + MaxElements) + 4, [NumElements]</Item>
          <Item Condition="MaxElements &gt;= 256 &amp;&amp; MaxElements &lt; 65536" Name="Next Indices" ExcludeView="simple">(uint16*)(this->_GetData() + MaxElements) + 2, [NumElements]</Item>
          <Item Condition="MaxElements &gt;=65536" Name="Next Indices" ExcludeView="simple">(uint32*)(this->_GetData() + MaxElements) + 1, [NumElements]</Item>
          <Item Condition="MaxElements &gt; 0 &amp;&amp; MaxElements &lt; 256" Name="Hash Indices" ExcludeView="simple">(uint8*)(this->_GetData() + MaxElements) + 4 + MaxElements, [*(uint32*)(this->_GetData() + MaxElements)]</Item>
          <Item Condition="MaxElements &gt;= 256 &amp;&amp; MaxElements &lt; 65536" Name="Hash Indices" ExcludeView="simple">(uint16*)(this->_GetData() + MaxElements) + 2 + MaxElements, [*(uint32*)(this->_GetData() + MaxElements)]</Item>
          <Item Condition="MaxElements &gt;=65536" Name="Hash Indices" ExcludeView="simple">(uint32*)(this->_GetData() + MaxElements) + MaxElements, [*(uint32*)(this->_GetData() + 1 + MaxElements)]</Item>
        </Expand>
      </Synthetic>
    </Expand>
  </Type>

  <!-- TSortedSet visualizer -->
  <Type Name="TSortedSet&lt;*,*,*&gt;">
    <Intrinsic Name="_Num" Expression="Elements._Num()" />
    <Intrinsic Name="_Max" Expression="Elements._Max()" />
    <Intrinsic Name="_IsValid" Expression="Elements._IsValid()" />
    <Intrinsic Name="_GetData" Expression="Elements._GetData()"/>
    <!-- Workaround: The cast to ElementType should be redundant, but is needed for some platforms. -->
    <Intrinsic Name="_GetElementPtr" Expression="(TSortedSet&lt;$T1,$T2,$T3&gt;::ElementType*)(this->_GetData() + Index)">
      <Parameter Name="Index" Type="int64"/>
    </Intrinsic>
    <DisplayString Condition="!this->_IsValid()">Invalid</DisplayString>
    <DisplayString Condition="this->_Num() > 0">Num={(*this)._Num()}, Max={(*this)._Max()}</DisplayString>
    <DisplayString Condition="this->_Max() > 0">Empty, Max={(*this)._Max()}</DisplayString>
    <DisplayString>Empty</DisplayString>
    <Expand>
      <CustomListItems>
        <Variable Name="Index" InitialValue="0" />
        <!-- Workaround: ElementsCount exists so that we could explicitly break the loop.
                         It's needed because on some platforms CustomListItems does not properly handle the Size tag and we
                         ended up with unbounded iteration over the collection leading to freezes in Visual Studio.
                         Intended to be removed once the debugger incompatibility on the platform in question is resolved.
                         Other visualizers using CustomListItems have been also updated. -->
        <Variable Name="ElementsCount" InitialValue="this->_Num()" />
        <Size>(*this)._IsValid() ? (*this)._Num() : 0</Size>
        <Loop Condition="ElementsCount > Index">
          <Item>*(*this)._GetElementPtr(Index)</Item>
          <Exec>++Index</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <Type Name="FDynamicCompactHashTable">
    <DisplayString Condition="NextIndexCount == 0">Empty</DisplayString>
    <DisplayString Condition="NextIndexCount != 0">NextIndexCount={NextIndexCount}, HashCount={HashCount}</DisplayString>
    <Expand>
      <Item Condition="NextIndexCount &gt; 0 &amp;&amp; NextIndexCount &lt; 256" Name="Next Indices" ExcludeView="simple">(uint8*)NextIndexData, [NextIndexCount]</Item>
      <Item Condition="NextIndexCount &gt;= 256 &amp;&amp; NextIndexCount &lt; 65536" Name="Next Indices" ExcludeView="simple">(uint16*)NextIndexData, [NextIndexCount]</Item>
      <Item Condition="NextIndexCount &gt;=65536" Name="Next Indices" ExcludeView="simple">(uint32*)NextIndexData, [NextIndexCount]</Item>
      <Item Condition="NextIndexCount &gt; 0 &amp;&amp; NextIndexCount &lt; 256" Name="Hash Indices" ExcludeView="simple">(uint8*)HashData, [HashCount]</Item>
      <Item Condition="NextIndexCount &gt;= 256 &amp;&amp; NextIndexCount &lt; 65536" Name="Hash Indices" ExcludeView="simple">(uint16*)HashData, [HashCount]</Item>
      <Item Condition="NextIndexCount &gt;=65536" Name="Hash Indices" ExcludeView="simple">(uint32*)HashData, [HashCount]</Item>
    </Expand>
  </Type>

