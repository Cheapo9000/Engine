	<!-- Declarations of Unreal Engine node definitions not supported by the Standard Library        -->
	<!--    Node Definitions                             -->
	<!--    Node: <dot>                                  -->
	<!-- No-op; passes its input to the output unchanged.-->
	<nodedef name="ND_dot_integer_float" node="dot" nodegroup="unrealengine">
		<input name="in" type="integer" value="0" />
		<input name="note" type="string" value="" uniform="true" />
		<output name="out" type="float" defaultinput="in" />
	</nodedef>  
	<nodedef name="ND_dot_boolean_float" node="dot" nodegroup="unrealengine">
		<input name="in" type="boolean" value="false" />
		<input name="note" type="string" value="" uniform="true" />
		<output name="out" type="float" defaultinput="in" />
	</nodedef>

