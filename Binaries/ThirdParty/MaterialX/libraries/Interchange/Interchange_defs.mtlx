	<!--    Node Graphs                                  -->
	<!--    Node: <convert>                              -->
	<nodegraph name="NG_convert_integer_float" nodedef="ND_convert_integer_float">
		<dot name="dot" type="float">
			<input name="in" type="integer" interfacename="in" />
		</dot>
		<output name="out" type="float" nodename="dot" />
	</nodegraph>  
	<nodegraph name="NG_convert_boolean_float" nodedef="ND_convert_boolean_float">
